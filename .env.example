# ========= 공공데이터포털 =========
# data.go.kr 마이페이지 > 인증키 관리 > "일반 인증키(Decoding)" 값을 그대로 붙여넣기
DATA_GO_KR_KEY=

# ========= 오피넷 (유가 카드를 쓸 때만) =========
# https://www.opinet.co.kr/user/custapi/custApiInfo.do 에서 발급
OPINET_KEY=

# ========= 인스타그램 =========
# facebook = graph.facebook.com (페이지 토큰, 만료 없음 · 권장)
# instagram = graph.instagram.com (페이지 불필요, 60일마다 갱신 필요)
IG_LOGIN_MODE=facebook
IG_API_VERSION=v26.0
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=

# ========= 이미지 호스팅 =========
# GitHub Pages 주소. 예) https://ttl10180-code.github.io/insta-databot
PUBLIC_BASE_URL=

# ========= 카드 설정 =========
CARD_HANDLE=@todays.data

# 기상청 격자 좌표 (60,127 = 서울 종로·중구 / 61,126 = 강남구)
WEATHER_NX=60
WEATHER_NY=127
WEATHER_REGION=서울

# 에어코리아 시도명
AIR_SIDO=서울

# 실거래가 대상 시군구 법정동코드 5자리 (쉼표 구분)
REALESTATE_LAWD_CDS=11680,11650,11710,11440,11560

# 오피넷 지역코드 (01=서울)
OPINET_AREA=01

# 1 로 두면 이미지만 만들고 실제 게시는 하지 않음
DRY_RUN=0

# ---------------- 추가 주제용 별도 기관 키 ----------------
# 없으면 해당 카드만 건너뛴다 (다른 카드는 정상 발행)
KOBIS_KEY=            # 영화 박스오피스 — kobis.or.kr 오픈API
EXIM_KEY=             # 환율 — koreaexim.go.kr 오픈API 인증키
KAMIS_KEY=            # 장바구니 물가 — kamis.or.kr 인증키
KAMIS_ID=             # 장바구니 물가 — kamis.or.kr 아이디

# 생활기상지수 (DATA_GO_KR_KEY 를 그대로 쓴다)
LIFEINDEX_AREA=1100000000
LIFEINDEX_REGION=서울

# 청약 카드에 노출할 지역. 비우면 전국. 예: 서울,경기
APPLY_AREAS=
